---
import { getExperience, formatYearMonth } from '@/lib/content';
import SectionHeading from './SectionHeading.astro';
const items = await getExperience();
---
<section id="experience" class="section border-t border-line" aria-labelledby="experience-title">
  <div class="container-page">
    <SectionHeading id="experience-title" eyebrow="Experience" title="Where I've worked" />
    <ol class="relative mt-12 space-y-10 border-l border-line pl-8 sm:ml-2">
      {items.map(({ data }) => (
        <li class="relative">
          <span class="absolute -left-[2.4rem] top-1.5 h-3.5 w-3.5 rounded-full border-2 border-accent bg-bg" aria-hidden="true"></span>
          <p class="text-sm font-medium text-muted">
            <time datetime={data.start}>{formatYearMonth(data.start)}</time> –{' '}
            {data.end === 'present' ? 'Present' : <time datetime={data.end}>{formatYearMonth(data.end)}</time>}
            {data.location && <span> · {data.location}</span>}
          </p>
          <h3 class="mt-1 text-lg font-semibold text-ink">{data.role} <span class="font-normal text-muted">· {data.org}</span></h3>
          <p class="mt-2 max-w-3xl leading-relaxed text-muted">{data.summary}</p>
          {data.highlights.length > 0 && (
            <ul class="mt-3 max-w-3xl list-disc space-y-1.5 pl-5 text-muted marker:text-accent">
              {data.highlights.map((h) => <li>{h}</li>)}
            </ul>
          )}
          {data.tags.length > 0 && <ul class="mt-4 flex flex-wrap gap-2" aria-label="Skills used">{data.tags.map((t) => <li class="chip">{t}</li>)}</ul>}
        </li>
      ))}
    </ol>
  </div>
</section>
