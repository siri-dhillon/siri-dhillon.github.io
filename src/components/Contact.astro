---
import { site } from '@/lib/site';
import { href } from '@/lib/paths';
import { publicFileExists } from '@/lib/content';
import { providerSetup, isConfigured } from '@/lib/form';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const { form } = site.contact;
const setup = providerSetup(form);
const configured = isConfigured(form);
const hasResume = publicFileExists(site.resumeUrl);
if (!configured) console.warn('[contact] Form endpoint is a placeholder — set contact.form.endpoint in src/data/site.json');
if (site.resumeUrl && !hasResume) console.warn(`[contact] ${site.resumeUrl} not found in /public — resume link hidden`);

const sideLinks = [
  site.bookingUrl && { label: 'Book a call', url: site.bookingUrl, icon: 'calendar' as const, external: true },
  hasResume && { label: 'Résumé (PDF)', url: href(site.resumeUrl), icon: 'file' as const, external: false },
  site.socials.linkedin && { label: 'LinkedIn', url: site.socials.linkedin, icon: 'linkedin' as const, external: true },
  site.socials.github && { label: 'GitHub', url: site.socials.github, icon: 'github' as const, external: true },
  site.email && { label: site.email, url: `mailto:${site.email}`, icon: 'mail' as const, external: false },
].filter(Boolean) as { label: string; url: string; icon: 'calendar' | 'file' | 'linkedin' | 'github' | 'mail'; external: boolean }[];
---
<section id="inquire" class="band-inverse section" aria-labelledby="inquire-title">
  <div class="container-page">
    <SectionHeading
      id="inquire-title"
      eyebrow="Inquire"
      title={site.contact.heading}
      titleMuted={site.contact.headingMuted}
      lead={site.contact.intro}
      align="center"
    />

    <div id="inquire-form" class="mx-auto mt-14 max-w-[40rem] rounded-card border border-line bg-surface p-6 shadow-raised sm:p-10" data-reveal>
      <form
        action={form.endpoint}
        method="POST"
        accept-charset="UTF-8"
        class="grid gap-6 sm:grid-cols-2"
        data-inquiry-form
        data-honeypot={setup.honeypot}
        aria-describedby={configured ? undefined : 'form-config-note'}
      >
        {Object.entries(setup.hidden).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
        <input type="hidden" name={setup.subjectField} value={`New inquiry from ${site.name}'s website`} />

        <!-- Honeypot: hidden from people and assistive tech; bots fill it in. -->
        <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
          <label>Leave this field empty <input type="text" name={setup.honeypot} tabindex="-1" autocomplete="off" /></label>
        </div>

        <div>
          <label for="f-name" class="label">Name <span class="text-muted" aria-hidden="true">*</span></label>
          <input id="f-name" name="name" type="text" required autocomplete="name" class="field" />
        </div>
        <div>
          <label for="f-email" class="label">Email <span class="text-muted" aria-hidden="true">*</span></label>
          <input id="f-email" name={setup.emailField} type="email" required autocomplete="email" spellcheck="false" class="field" />
        </div>
        <div>
          <label for="f-type" class="label">Project type <span class="text-muted" aria-hidden="true">*</span></label>
          <select id="f-type" name="project_type" required class="field">
            <option value="">Select…</option>
            {form.projectTypes.map((o) => <option>{o}</option>)}
          </select>
        </div>
        <div>
          <label for="f-budget" class="label">Budget range</label>
          <select id="f-budget" name="budget" class="field">
            <option value="">Select…</option>
            {form.budgets.map((o) => <option>{o}</option>)}
          </select>
        </div>
        <div class="sm:col-span-2">
          <label for="f-timeline" class="label">Timeline</label>
          <select id="f-timeline" name="timeline" class="field">
            <option value="">Select…</option>
            {form.timelines.map((o) => <option>{o}</option>)}
          </select>
        </div>
        <div class="sm:col-span-2">
          <label for="f-message" class="label">Message <span class="text-muted" aria-hidden="true">*</span></label>
          <textarea id="f-message" name="message" rows="5" required minlength="10" class="field resize-y"
            placeholder="e.g. An internal doc search for our support team…"></textarea>
        </div>

        <div class="flex flex-col gap-4 sm:col-span-2 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-body-sm text-muted"><span aria-hidden="true">*</span> Required</p>
          <button type="submit" class="btn-primary group" disabled={!configured}>
            <span data-label>Send Inquiry</span> <Icon name="arrowRight" class="nudge h-4 w-4" />
          </button>
        </div>
        {!configured && (
          <p id="form-config-note" class="rounded-control border border-dashed border-line p-3 text-body-sm text-muted sm:col-span-2">
            The inquiry form isn't connected yet. Please reach out on LinkedIn in the meantime.
          </p>
        )}
        <p data-error role="alert" class="hidden rounded-control border border-danger/40 bg-danger-soft p-3 text-body-sm text-danger sm:col-span-2"></p>
      </form>

      <div data-success class="hidden py-8 text-center" tabindex="-1" role="status">
        <span class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-accent-soft text-accent"><Icon name="check" class="h-6 w-6" /></span>
        <h3 class="mt-4 text-h4 text-ink">Thanks, your message is on its way.</h3>
        <p class="mt-2 text-muted">I'll get back to you within 2 business days.</p>
      </div>
    </div>

    {sideLinks.length > 0 && (
      <ul class="mx-auto mt-10 flex max-w-[40rem] flex-wrap justify-center gap-x-6 gap-y-3" aria-label="Other ways to reach me">
        {sideLinks.map((l) => (
          <li>
            <a href={l.url} class="group inline-flex min-h-11 items-center gap-2 text-label text-muted transition-colors hover:text-ink"
              {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              <Icon name={l.icon} class="h-4 w-4" />
              {l.label}
              {l.external && <span class="sr-only">(opens in a new tab)</span>}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-inquiry-form]');
  if (form) {
    const success = form.parentElement!.querySelector<HTMLElement>('[data-success]')!;
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = button.querySelector<HTMLElement>('[data-label]')!;
    const honeypot = form.dataset.honeypot || '_gotcha';

    // Warn before leaving with a half-written message.
    let dirty = false;
    form.addEventListener('input', () => { dirty = true; });
    window.addEventListener('beforeunload', (e) => { if (dirty) e.preventDefault(); });

    const showSuccess = () => {
      dirty = false;
      form.classList.add('hidden');
      success.classList.remove('hidden');
      success.focus();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      error.classList.add('hidden');
      const data = new FormData(form);

      // Bot filled the honeypot: pretend it worked, send nothing.
      if (String(data.get(honeypot) ?? '').trim() !== '') return showSuccess();

      button.disabled = true;
      label.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const body = await res.json().catch(() => ({}));
        if (!res.ok || body?.success === false) throw new Error(body?.errors?.[0]?.message || body?.message || `HTTP ${res.status}`);
        form.reset();
        showSuccess();
      } catch (err) {
        error.textContent = "Sorry, your message couldn't be sent. Please try again, or reach out on LinkedIn.";
        error.classList.remove('hidden');
        console.error('[contact]', err);
      } finally {
        button.disabled = false;
        label.textContent = 'Send Inquiry';
      }
    });
  }
</script>
