---
/**
 * How I work (DESIGN.md §6): the engagement timeline as an ordered list (horizontal
 * at lg, vertical below), then engagement types from the services collection.
 */
import { site } from '@/lib/site';
import { getServices } from '@/lib/content';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const steps = site.process;
const services = await getServices();
---
<section id="process" class="section bg-surface" aria-labelledby="process-title">
  <div class="container-page">
    <SectionHeading
      id="process-title"
      eyebrow="How I work"
      title="Prototype first."
      titleMuted="Decisions get made on something you can use."
      align="center"
    />

    {steps.length > 0 && (
      <div class="relative mt-16 lg:mt-24">
        <!-- Connecting hairline: vertical on mobile, horizontal at lg. Decorative. -->
        <span aria-hidden="true" class="absolute bottom-2 left-[5px] top-2 w-px bg-line lg:inset-x-0 lg:bottom-auto lg:left-0 lg:top-[5px] lg:h-px lg:w-full"></span>
      <ol class="relative grid gap-10 lg:grid-cols-5 lg:gap-6">
        {steps.map((s, i) => (
          <li class="relative pl-8 lg:pl-0 lg:pt-10" data-reveal style={`--reveal-i: ${i % 3}`}>
            <span
              aria-hidden="true"
              class:list={[
                'absolute left-0 top-1 h-[11px] w-[11px] rounded-full border-2 lg:top-0',
                i === 0 ? 'border-accent bg-accent' : 'border-line-strong bg-surface',
              ]}
            ></span>
            <p class="font-mono text-mono-label uppercase text-accent">{s.when}</p>
            <h3 class="mt-2 text-h4 text-ink">{s.title}</h3>
            <p class="mt-2 text-body-sm text-muted">{s.text}</p>
          </li>
        ))}
      </ol>
      </div>
    )}

    {services.length > 0 && (
      <div class="mt-24 lg:mt-32">
        <h3 class="text-center font-mono text-mono-label uppercase text-faint" data-reveal>Engagements</h3>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {services.map(({ data }, i) => (
            <li class="rounded-card border border-line bg-bg p-6 sm:p-8" data-reveal style={`--reveal-i: ${i % 2}`}>
              <div class="flex items-center gap-3">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-accent-soft text-accent"><Icon name={data.icon} class="h-4 w-4" /></span>
                <h4 class="text-h4 text-ink">{data.title}</h4>
              </div>
              <p class="mt-4 text-body-sm text-muted">{data.summary}</p>
              <ul class="mt-5 space-y-2 text-body-sm text-muted" aria-label={`${data.title} deliverables`}>
                {data.deliverables.slice(0, 4).map((d) => (
                  <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-accent" />{d}</li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
