---
import { site } from '@/lib/site';
import Icon from './Icon.astro';
interface Props { class?: string }
const links = [
  { label: 'GitHub', url: site.socials.github, icon: 'github' as const },
  { label: 'LinkedIn', url: site.socials.linkedin, icon: 'linkedin' as const },
  { label: 'Hugging Face', url: site.socials.huggingface, icon: 'huggingface' as const },
].filter((l) => l.url);
---
<ul class:list={['flex items-center gap-2', Astro.props.class]}>
  {links.map((l) => (
    <li>
      <a href={l.url} target="_blank" rel="noopener noreferrer me"
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-line text-muted transition-colors hover:bg-surface-2 hover:text-ink">
        <Icon name={l.icon} />
        <span class="sr-only">{l.label} (opens in a new tab)</span>
      </a>
    </li>
  ))}
</ul>
