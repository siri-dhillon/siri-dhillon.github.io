---
/** Proof strip (DESIGN.md §6): real, published numbers only; each tile links to its source. */
import { site } from '@/lib/site';
import { href } from '@/lib/paths';
import Icon from './Icon.astro';
const tiles = site.proof;
---
{tiles.length > 0 && (
  <section class="band-inverse py-20 lg:py-28" aria-labelledby="proof-title">
    <div class="container-page">
      <h2 id="proof-title" class="eyebrow text-center" data-reveal>Measured results</h2>
      <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {tiles.map((t, i) => (
          <li
            class="group relative flex flex-col rounded-card border border-line p-6 transition-colors hover:border-accent/60 has-[a:focus-visible]:border-accent has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-ring"
            data-reveal
            style={`--reveal-i: ${i % 3}`}
          >
            <p class="font-mono text-readout tabular-nums text-ink break-words">{t.value}</p>
            <p class="mt-4 font-mono text-mono-label uppercase text-muted">{t.caption}</p>
            <a
              href={href(t.href)}
              class="mt-6 inline-flex items-center gap-1.5 text-body-sm text-faint transition-colors after:absolute after:inset-0 after:rounded-card group-hover:text-accent focus-visible:outline-none"
            >
              {t.source} <Icon name="arrowRight" class="nudge h-3.5 w-3.5" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
