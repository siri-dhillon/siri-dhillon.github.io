---
/**
 * Selected work (DESIGN.md §6): one full-width row per featured project, alternating
 * sides. The visual is the real screenshot when one exists, otherwise a spec panel of
 * the project's facts. Never invented imagery or metrics.
 */
import { getFeaturedProjects, publicDetails } from '@/lib/content';
import { href } from '@/lib/paths';
import { publicImageSize } from '@/lib/markdown-case-study.mjs';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const projects = await Promise.all(
  (await getFeaturedProjects()).slice(0, 4).map(async (p) => {
    const { cover, coverAlt } = publicDetails(p);
    return { p, cover, coverAlt, size: cover ? await publicImageSize(cover) : undefined };
  }),
);
---
<section id="work" class="section" aria-labelledby="work-title">
  <div class="container-page">
    <SectionHeading
      id="work-title"
      eyebrow="Selected work"
      title="Things I've built."
      titleMuted="The problem, the build and the result."
    />

    <ol class="mt-16 space-y-20 lg:mt-24 lg:space-y-32">
      {projects.map(({ p, cover, coverAlt, size }, i) => {
        const d = p.data;
        const titleId = `fw-${p.id}`;
        return (
          <li class="group relative grid items-center gap-8 lg:grid-cols-12 lg:gap-16" data-reveal>
            <div class:list={['lg:col-span-7', i % 2 === 1 && 'lg:order-2']}>
              {cover ? (
                <img
                  src={href(cover)}
                  alt={coverAlt}
                  width={size?.width}
                  height={size?.height}
                  loading="lazy"
                  decoding="async"
                  class="h-auto w-full rounded-panel border border-line shadow-raised"
                />
              ) : (
                <div class="rounded-panel border border-line bg-surface p-6 sm:p-10">
                  <dl class="grid gap-4 font-mono text-mono-sm">
                    {[
                      ['category', d.category],
                      ['role', d.role],
                      ['year', String(d.year)],
                      ['industry', d.industry],
                      ['stack', d.stack.slice(0, 6).join(' · ')],
                    ].map(([k, v]) => (
                      <div class="grid grid-cols-[6.5rem_1fr] gap-4 border-b border-line pb-4 last:border-0 last:pb-0">
                        <dt class="text-faint">{k}</dt>
                        <dd class="text-ink">{v}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              )}
            </div>

            <div class:list={['lg:col-span-5', i % 2 === 1 && 'lg:order-1']}>
              <p class="font-mono text-mono-sm text-faint">
                <span class="text-accent">{d.category}</span> · {d.year}
              </p>
              <h3 id={titleId} class="mt-3 text-h3 text-ink">
                <a
                  href={href(`/work/${p.id}/`)}
                  class="after:absolute after:inset-0 after:rounded-panel focus-visible:outline-none group-has-[a:focus-visible]:underline"
                >
                  {d.title}
                </a>
              </h3>
              <p class="mt-4 text-body-lg text-muted">{d.summary}</p>
              <p class="mt-5 line-clamp-3 text-body-sm text-muted">
                <span class="font-mono text-mono-label uppercase text-ink">Result</span> {d.outcome}
              </p>
              <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tech stack">
                {d.stack.slice(0, 5).map((s) => <li class="chip">{s}</li>)}
              </ul>
              <p class="mt-8 inline-flex items-center gap-2 text-label text-accent" aria-hidden="true">
                Read Case Study <Icon name="arrowRight" class="nudge h-4 w-4" />
              </p>
            </div>
          </li>
        );
      })}
    </ol>

    <div class="mt-20 text-center" data-reveal>
      <a href={href('/work/')} class="btn-secondary group">All Work <Icon name="arrowRight" class="nudge h-4 w-4" /></a>
    </div>
  </div>
</section>

<style>
  /* Keyboard focus on the stretched title link rings the whole row. */
  li:has(a:focus-visible) {
    outline: 2px solid var(--ring);
    outline-offset: 12px;
    border-radius: var(--radius-panel);
  }
</style>
