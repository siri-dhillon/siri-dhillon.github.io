---
interface Props { eyebrow: string; title: string; id?: string; lead?: string; class?: string }
const { eyebrow, title, id, lead, class: cls } = Astro.props;
---
<div class:list={['max-w-3xl', cls]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="h2" id={id}>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</div>
