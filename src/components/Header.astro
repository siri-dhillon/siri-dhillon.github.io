---
/** Top bar (DESIGN.md §6): identity + one quiet proof chip + theme toggle. Navigation lives in the Inquire dock. */
import { site } from '@/lib/site';
import { href } from '@/lib/paths';
import ThemeToggle from './ThemeToggle.astro';
---
<header class="relative z-10">
  <div class="container-page flex h-18 items-center justify-between gap-4">
    <a href={href('/')} class="group flex items-center gap-3 rounded-full text-label text-ink">
      <span
        class="grid h-9 w-9 place-items-center rounded-full bg-accent font-mono text-mono-sm font-medium text-accent-fg transition-colors group-hover:bg-accent-hover"
        aria-hidden="true">{site.monogram}</span
      >
      <span class="transition-colors group-hover:text-accent">{site.name}</span>
    </a>
    <div class="flex items-center gap-4">
      {site.certifications.length > 0 && (
        <p class="hidden font-mono text-mono-sm text-faint md:block">AWS · Security+ certified</p>
      )}
      <ThemeToggle />
    </div>
  </div>
</header>
