---
import { getServices } from '@/lib/content';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
const services = await getServices();
---
<section id="services" class="section border-t border-line bg-surface/50" aria-labelledby="services-title">
  <div class="container-page">
    <SectionHeading id="services-title" eyebrow="Services" title="How I can help"
      lead="Engagements range from a 2-week prototype to an embedded, months-long build with your team." />
    <ul class="mt-12 grid gap-5 sm:grid-cols-2">
      {services.map(({ data }) => (
        <li class="card flex flex-col bg-bg">
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-accent-soft text-accent"><Icon name={data.icon} class="h-6 w-6" /></span>
          <h3 class="mt-5 text-lg font-semibold text-ink">{data.title}</h3>
          <p class="mt-2 leading-relaxed text-muted">{data.summary}</p>
          <ul class="mt-5 space-y-2 text-sm text-muted">
            {data.deliverables.map((d) => (
              <li class="flex gap-2"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-accent" />{d}</li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>
