---
/**
 * Compact project card for grids (/work, "Next case study"). DESIGN.md §6:
 * flat surface card, hairline, hover border to accent; the title link is stretched
 * over the card and keyboard focus rings the whole card.
 */
import type { Project } from '@/lib/content';
import { href } from '@/lib/paths';
import Icon from './Icon.astro';

interface Props { project: Project; headingLevel?: 'h3' | 'h2' }
const { project, headingLevel: H = 'h3' } = Astro.props;
const d = project.data;
const url = href(`/work/${project.id}/`);
const titleId = `p-${project.id}`;
const metric = d.confidential ? undefined : d.metrics[0];
---
<article
  class="group relative flex h-full flex-col rounded-card border border-line bg-surface p-6 transition-colors hover:border-accent/50 has-[a:focus-visible]:border-accent has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-ring sm:p-8"
  aria-labelledby={titleId}
  data-category={d.category}
>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <span class="chip !bg-accent-soft !text-accent">{d.category}</span>
    <span class="font-mono text-mono-sm tabular-nums text-faint">{d.year}</span>
    {d.confidential && (
      <span class="ml-auto inline-flex items-center gap-1 font-mono text-mono-sm text-faint" title="Client details anonymized">
        <Icon name="lock" class="h-3.5 w-3.5" /> NDA
      </span>
    )}
  </div>

  <H id={titleId} class="mt-5 text-h4 text-ink">
    <a href={url} class="after:absolute after:inset-0 after:rounded-card focus-visible:outline-none group-has-[a:focus-visible]:underline">
      {d.title}
    </a>
  </H>
  <p class="mt-3 text-body-sm text-muted">{d.summary}</p>

  {metric && (
    <p class="mt-5 flex items-baseline gap-2">
      <span class="font-mono text-h4 tabular-nums text-ink">{metric.value}</span>
      <span class="font-mono text-mono-label uppercase text-faint">{metric.caption}</span>
    </p>
  )}

  <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tech stack">
    {d.stack.slice(0, 4).map((s) => <li class="chip">{s}</li>)}
    {d.stack.length > 4 && (
      <li class="chip"><span aria-hidden="true">+{d.stack.length - 4}</span><span class="sr-only">and {d.stack.length - 4} more</span></li>
    )}
  </ul>

  <p class="mt-auto inline-flex items-center gap-2 pt-8 text-label text-accent" aria-hidden="true">
    Read Case Study <Icon name="arrowRight" class="nudge h-4 w-4" />
  </p>
</article>
