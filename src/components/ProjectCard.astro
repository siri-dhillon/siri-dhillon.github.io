---
import type { Project } from '@/lib/content';
import { href } from '@/lib/paths';
import Icon from './Icon.astro';

interface Props { project: Project; variant?: 'featured' | 'compact'; headingLevel?: 'h3' | 'h2' }
const { project, variant = 'compact', headingLevel: H = 'h3' } = Astro.props;
const d = project.data;
const url = href(`/work/${project.id}/`);
const titleId = `p-${project.id}`;
---
<article
  class="group relative flex h-full flex-col rounded-2xl border border-line bg-bg p-6 transition-colors hover:border-accent/60 has-[a:focus-visible]:border-accent has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-ring sm:p-7"
  aria-labelledby={titleId}
  data-category={d.category}
>
  <div class="flex flex-wrap items-center gap-2 text-xs">
    <span class="chip !border-transparent !bg-accent-soft !text-accent">{d.category}</span>
    <span class="text-muted">{d.year}</span>
    <span class="text-muted" aria-hidden="true">·</span>
    <span class="text-muted">{d.industry}</span>
    {d.confidential && (
      <span class="ml-auto inline-flex items-center gap-1 text-muted" title="Client details anonymized">
        <Icon name="lock" class="h-3.5 w-3.5" /> <span>NDA</span>
      </span>
    )}
  </div>

  <H id={titleId} class="mt-4 text-xl font-semibold leading-snug tracking-tight text-ink">
    <a href={url} class="after:absolute after:inset-0 after:rounded-2xl focus-visible:outline-none group-has-[a:focus-visible]:underline">
      {d.title}
    </a>
  </H>

  {variant === 'compact' ? (
    <p class="mt-3 leading-relaxed text-muted">{d.summary}</p>
  ) : (
    <dl class="mt-5 space-y-4 text-[0.95rem] leading-relaxed">
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wider text-ink">Problem</dt>
        <dd class="mt-1 line-clamp-3 text-muted">{d.problem}</dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wider text-ink">What I built</dt>
        <dd class="mt-1 line-clamp-3 text-muted">{d.solution}</dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wider text-ink">Stack</dt>
        <dd class="mt-2">
          <ul class="flex flex-wrap gap-2">{d.stack.slice(0, 7).map((s) => <li class="chip">{s}</li>)}</ul>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wider text-ink">Result</dt>
        <dd class="mt-1 line-clamp-3 text-muted">{d.outcome}</dd>
      </div>
    </dl>
  )}

  {variant === 'compact' && (
    <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tech stack">
      {d.stack.slice(0, 5).map((s) => <li class="chip">{s}</li>)}
    </ul>
  )}

  <p class="mt-auto pt-6 text-sm font-semibold text-accent" aria-hidden="true">
    Read case study <Icon name="arrowRight" class="inline h-4 w-4 transition-transform group-hover:translate-x-1" />
  </p>
</article>
