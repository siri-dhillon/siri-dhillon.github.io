---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ProofStrip from '@/components/ProofStrip.astro';
import FeaturedWork from '@/components/FeaturedWork.astro';
import CurrentWork from '@/components/CurrentWork.astro';
import HowIWork from '@/components/HowIWork.astro';
import About from '@/components/About.astro';
import Contact from '@/components/Contact.astro';
import { site } from '@/lib/site';
import { absolute } from '@/lib/paths';

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'AI & Software Engineer',
  url: absolute('/', Astro.site),
  image: site.photo ? absolute(site.photo, Astro.site) : undefined,
  sameAs: Object.values(site.socials).filter(Boolean),
};
---
<BaseLayout>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personLd)} />
  <!-- Section order: DESIGN.md §8. CurrentWork renders only when site.currentWork.enabled. -->
  <Hero />
  <ProofStrip />
  <FeaturedWork />
  <CurrentWork />
  <HowIWork />
  <About />
  <Contact />
</BaseLayout>
