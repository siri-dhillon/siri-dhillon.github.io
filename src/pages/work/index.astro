---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { getProjects } from '@/lib/content';
import { PROJECT_CATEGORIES } from '@/content.config';

const projects = await getProjects();
const counts = Object.fromEntries(PROJECT_CATEGORIES.map((c) => [c, projects.filter((p) => p.data.category === c).length]));
const categories = PROJECT_CATEGORIES.filter((c) => counts[c] > 0);
---
<BaseLayout title="Work" description="Projects by Sirpreet Dhillon across AI/LLM, full-stack, data, cloud architecture, and edge systems.">
  <section class="container-page pb-24 pt-16 sm:pt-24" aria-labelledby="work-title">
    <p class="eyebrow">Work</p>
    <h1 id="work-title" class="mt-4 text-h1 text-ink">All projects</h1>
    <p class="lead">AI, full-stack, data, and systems projects, from LLM agents and web apps to FPGA hardware and network simulation. Client work is anonymized.</p>

    <div class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filter projects by category" data-filters>
      <button type="button" class="filter-btn" aria-pressed="true" data-filter="all">All <span class="text-muted">({projects.length})</span></button>
      {categories.map((c) => (
        <button type="button" class="filter-btn" aria-pressed="false" data-filter={c}>{c} <span class="text-muted">({counts[c]})</span></button>
      ))}
    </div>
    <p class="sr-only" aria-live="polite" data-filter-status></p>

    <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-project-list>
      {projects.map((p) => (
        <li data-category={p.data.category}><ProjectCard project={p} headingLevel="h2" /></li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  @reference "../../styles/global.css";
  .filter-btn {
    @apply rounded-full border border-line bg-bg px-4 py-2 text-sm font-medium text-ink transition-colors hover:bg-surface-2;
  }
  .filter-btn[aria-pressed='true'] {
    @apply border-accent bg-accent text-accent-fg;
  }
  .filter-btn[aria-pressed='true'] span { @apply text-accent-fg/80; }
</style>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const items = [...document.querySelectorAll<HTMLElement>('[data-project-list] > li')];
  const status = document.querySelector<HTMLElement>('[data-filter-status]');

  function apply(filter: string, updateUrl = true) {
    if (filter !== 'all' && !buttons.some((b) => b.dataset.filter === filter)) filter = 'all';
    let shown = 0;
    items.forEach((li) => {
      const show = filter === 'all' || li.dataset.category === filter;
      li.hidden = !show;
      if (show) shown++;
    });
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
    if (status) status.textContent = `Showing ${shown} project${shown === 1 ? '' : 's'}${filter === 'all' ? '' : ` in ${filter}`}`;
    if (updateUrl) {
      const url = new URL(location.href);
      filter === 'all' ? url.searchParams.delete('category') : url.searchParams.set('category', filter);
      history.replaceState(null, '', url);
    }
  }

  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));
  const initial = new URLSearchParams(location.search).get('category');
  if (initial) apply(initial, false);
</script>
