---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { getProjects, publicDetails, type Project } from '@/lib/content';
import { href } from '@/lib/paths';
import { publicImageSize } from '@/lib/markdown-case-study.mjs';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}) satisfies GetStaticPaths;

interface Props { project: Project; next: Project }
const { project, next } = Astro.props;
const d = project.data;
const { links, cover, coverAlt } = publicDetails(project);
const { Content } = await render(project);
const coverSize = cover ? await publicImageSize(cover) : undefined;
const hasBody = Boolean(project.body?.replace(/<!--[\s\S]*?-->/g, '').trim());

const facts = [
  { label: 'Industry', value: d.industry },
  { label: 'Role', value: d.role },
  { label: 'Year', value: String(d.year) },
  { label: 'Category', value: d.category },
];
// Two-tone title (DESIGN.md §6): ink up to the first ", " or " — ", muted after it.
const split = d.title.match(/^(.+?)(,| —)\s+(.+)$/);
const titleInk = split ? `${split[1]}${split[2]}` : d.title;
const titleMuted = split ? split[3] : '';
const metrics = d.confidential ? [] : d.metrics;

const sections = [
  { id: 'problem', title: 'The problem', text: d.problem },
  { id: 'solution', title: 'What I built', text: d.solution },
  { id: 'outcome', title: 'The result', text: d.outcome },
];
---
<BaseLayout title={d.title} description={d.summary} image={cover} type="article">
  <article class="container-page pb-24 pt-16 lg:pb-40 lg:pt-24" aria-labelledby="cs-title">
    <a href={href('/work/')} class="group inline-flex min-h-11 items-center gap-2 font-mono text-mono-sm text-faint transition-colors hover:text-ink">
      <Icon name="arrowLeft" class="h-4 w-4" /> All work
    </a>

    <header class="mt-10 max-w-4xl" data-reveal>
      <p class="eyebrow">Case study · {d.category} · {d.year}</p>
      <h1 id="cs-title" class="mt-4 text-h1 text-ink">
        {titleInk}{titleMuted && <> <span class="tone-muted">{titleMuted}</span></>}
      </h1>
      <p class="lead">{d.summary}</p>
      {d.confidential && (
        <p class="mt-8 inline-flex items-center gap-2 rounded-full bg-surface-2 px-4 py-2 text-body-sm text-muted">
          <Icon name="lock" class="h-4 w-4" /> Client work under NDA. Identifying details have been removed.
        </p>
      )}
      {(links.demo || links.repo) && (
        <div class="mt-10 flex flex-wrap gap-3">
          {links.demo && <a href={links.demo} target="_blank" rel="noopener noreferrer" class="btn-secondary group">Live Demo <Icon name="arrowUpRight" class="h-4 w-4" /><span class="sr-only">(opens in a new tab)</span></a>}
          {links.repo && <a href={links.repo} target="_blank" rel="noopener noreferrer" class="btn-secondary group">Source Code <Icon name="github" class="h-4 w-4" /><span class="sr-only">(opens in a new tab)</span></a>}
        </div>
      )}
    </header>

    {metrics.length > 0 && (
      <section class="mt-16" aria-labelledby="metrics-title">
        <h2 id="metrics-title" class="sr-only">Headline results</h2>
        <ul class:list={['grid gap-4 sm:grid-cols-2', metrics.length >= 3 && 'lg:grid-cols-4']}>
          {metrics.map((m, i) => (
            <li class="rounded-card border border-line bg-surface p-6" data-reveal style={`--reveal-i: ${i % 3}`}>
              <p class="font-mono text-readout tabular-nums text-ink">{m.value}</p>
              <p class="mt-4 font-mono text-mono-label uppercase text-muted">{m.caption}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {cover && (
      <img src={href(cover)} alt={coverAlt} width={coverSize?.width} height={coverSize?.height}
        class="mt-16 h-auto w-full rounded-panel border border-line object-cover shadow-raised" loading="eager" fetchpriority="high" decoding="async" />
    )}

    <div class="mt-20 grid gap-16 lg:mt-28 lg:grid-cols-12">
      <div class="min-w-0 lg:col-span-8">
        {sections.map((s, i) => (
          <section class="border-t border-line py-12 first:border-t-0 first:pt-0" aria-labelledby={s.id} data-reveal>
            <p class="font-mono text-mono-label uppercase text-accent" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
            <h2 id={s.id} class="mt-3 text-h3 text-ink">{s.title}</h2>
            <p class="mt-5 max-w-[62ch] text-body-lg text-muted">{s.text}</p>
          </section>
        ))}
        {hasBody && (
          <section class="border-t border-line pt-12" aria-labelledby="deep-dive">
            <p class="font-mono text-mono-label uppercase text-accent" aria-hidden="true">{String(sections.length + 1).padStart(2, '0')}</p>
            <h2 id="deep-dive" class="mt-3 text-h3 text-ink">Deep dive</h2>
            <div class="prose-content mt-2"><Content /></div>
          </section>
        )}
      </div>

      <aside class="lg:sticky lg:top-8 lg:col-span-4 lg:self-start" aria-label="Project facts">
        <dl class="card space-y-6">
          {facts.map((f) => (
            <div><dt class="font-mono text-mono-label uppercase text-faint">{f.label}</dt><dd class="mt-1.5 text-label text-ink">{f.value}</dd></div>
          ))}
          <div>
            <dt class="font-mono text-mono-label uppercase text-faint">Stack</dt>
            <dd class="mt-3"><ul class="flex flex-wrap gap-2">{d.stack.map((s) => <li class="chip">{s}</li>)}</ul></dd>
          </div>
        </dl>
        <p class="mt-6 px-2 text-body-sm text-muted">
          Have a similar problem? <a href={href('/#inquire')} class="link">Inquire</a>
        </p>
      </aside>
    </div>

    {next.id !== project.id && (
      <nav class="mt-24 border-t border-line pt-16 lg:mt-32" aria-labelledby="next-title">
        <p id="next-title" class="eyebrow">Next case study</p>
        <div class="mt-8 max-w-xl"><ProjectCard project={next} headingLevel="h2" /></div>
      </nav>
    )}
  </article>
</BaseLayout>
