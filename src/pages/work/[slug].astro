---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { getProjects, publicDetails, type Project } from '@/lib/content';
import { href } from '@/lib/paths';
import { publicImageSize } from '@/lib/markdown-case-study.mjs';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}) satisfies GetStaticPaths;

interface Props { project: Project; next: Project }
const { project, next } = Astro.props;
const d = project.data;
const { links, cover, coverAlt } = publicDetails(project);
const { Content } = await render(project);
const coverSize = cover ? await publicImageSize(cover) : undefined;
const hasBody = Boolean(project.body?.replace(/<!--[\s\S]*?-->/g, '').trim());

const facts = [
  { label: 'Industry', value: d.industry },
  { label: 'Role', value: d.role },
  { label: 'Year', value: String(d.year) },
  { label: 'Category', value: d.category },
];
const sections = [
  { id: 'problem', title: 'The problem', text: d.problem },
  { id: 'solution', title: 'What I built', text: d.solution },
  { id: 'outcome', title: 'The result', text: d.outcome },
];
---
<BaseLayout title={d.title} description={d.summary} image={cover} type="article">
  <article class="container-page pb-24 pt-12 sm:pt-16" aria-labelledby="cs-title">
    <a href={href('/work/')} class="inline-flex items-center gap-2 text-sm font-medium text-muted hover:text-ink">
      <Icon name="arrowLeft" class="h-4 w-4" /> All work
    </a>

    <header class="mt-8 max-w-4xl">
      <p class="eyebrow">Case study · {d.category}</p>
      <h1 id="cs-title" class="mt-4 text-h1 text-ink">{d.title}</h1>
      <p class="lead">{d.summary}</p>
      {d.confidential && (
        <p class="mt-6 inline-flex items-center gap-2 rounded-control border border-line bg-surface px-3 py-2 text-sm text-muted">
          <Icon name="lock" class="h-4 w-4" /> Client work under NDA. Identifying details have been removed.
        </p>
      )}
      {(links.demo || links.repo) && (
        <div class="mt-8 flex flex-wrap gap-3">
          {links.demo && <a href={links.demo} target="_blank" rel="noopener noreferrer" class="btn-primary">Live demo <Icon name="arrowUpRight" class="h-4 w-4" /><span class="sr-only">(opens in a new tab)</span></a>}
          {links.repo && <a href={links.repo} target="_blank" rel="noopener noreferrer" class="btn-secondary">Source code <Icon name="github" class="h-4 w-4" /><span class="sr-only">(opens in a new tab)</span></a>}
        </div>
      )}
    </header>

    {cover && (
      <img src={href(cover)} alt={coverAlt} width={coverSize?.width} height={coverSize?.height}
        class="mt-12 h-auto w-full rounded-panel border border-line object-cover shadow-raised" loading="eager" fetchpriority="high" decoding="async" />
    )}

    <div class="mt-14 grid gap-12 lg:grid-cols-[1fr_280px]">
      <div class="min-w-0">
        {sections.map((s) => (
          <section class="border-t border-line py-8 first:border-t-0 first:pt-0" aria-labelledby={s.id}>
            <h2 id={s.id} class="text-h3 text-ink">{s.title}</h2>
            <p class="mt-4 text-[1.0625rem] leading-relaxed text-muted">{s.text}</p>
          </section>
        ))}
        {hasBody && (
          <section class="border-t border-line pt-8" aria-labelledby="deep-dive">
            <h2 id="deep-dive" class="text-h3 text-ink">Deep dive</h2>
            <div class="prose-content mt-2"><Content /></div>
          </section>
        )}
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start" aria-label="Project facts">
        <dl class="card space-y-5">
          {facts.map((f) => (
            <div><dt class="font-mono text-mono-label uppercase text-faint">{f.label}</dt><dd class="mt-1 font-medium text-ink">{f.value}</dd></div>
          ))}
          <div>
            <dt class="font-mono text-mono-label uppercase text-faint">Stack</dt>
            <dd class="mt-2"><ul class="flex flex-wrap gap-2">{d.stack.map((s) => <li class="chip">{s}</li>)}</ul></dd>
          </div>
        </dl>
        <a href={href('/#inquire')} class="btn-primary mt-5 w-full">Inquire</a>
      </aside>
    </div>

    {next.id !== project.id && (
      <nav class="mt-20 border-t border-line pt-12" aria-labelledby="next-title">
        <p id="next-title" class="eyebrow">Next case study</p>
        <div class="mt-6 max-w-xl"><ProjectCard project={next} headingLevel="h2" /></div>
      </nav>
    )}
  </article>
</BaseLayout>
