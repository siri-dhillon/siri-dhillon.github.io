---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { href } from '@/lib/paths';
---
<BaseLayout title="Page not found" noindex>
  <section class="container-page py-32 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 text-h1 text-ink">This page doesn't exist</h1>
    <p class="mx-auto mt-4 max-w-md text-muted">It may have moved. Try the homepage or the project list.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href={href('/')} class="btn-primary">Home</a>
      <a href={href('/work/')} class="btn-secondary">All work</a>
    </div>
  </section>
</BaseLayout>
