---
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import InquireDock from '@/components/InquireDock.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}
const props = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <SEO {...props} />
    <!-- Apply saved / system theme before first paint to avoid a flash; keep theme-color in sync. -->
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem('theme');
          var dark = s ? s === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
          if (s) {
            document.querySelectorAll('meta[data-theme-color]').forEach(function (m) {
              m.removeAttribute('media');
              m.setAttribute('content', dark ? '#0a0d10' : '#ffffff');
            });
          }
        } catch (e) {}
        // Section reveal is progressive enhancement: only opt in when it can run.
        if ('IntersectionObserver' in window) document.documentElement.classList.add('js-reveal');
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only z-[100] rounded-lg bg-accent px-4 py-2 font-semibold text-accent-fg focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
      >Skip to content</a
    >
    <!-- Primary nav: first in the DOM for keyboard/AT users, drawn at the bottom. -->
    <InquireDock />
    <Header />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
    <script>
      // Reveal [data-reveal] elements once as they enter the viewport (DESIGN.md §5).
      const root = document.documentElement;
      if (root.classList.contains('js-reveal')) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add('is-revealed');
            io.unobserve(e.target);
          }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
